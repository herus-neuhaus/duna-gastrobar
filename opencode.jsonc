{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "build",
  "providers": {
    "openai": {
      "models": {
        "gpt-6.1-sol": {
          "settings": { "reasoningEffort": "high" }
        }
      }
    }
  },
  "permissions": [
    { "action": "execute", "resource": "*", "effect": "deny" },
    { "action": "supabase_*", "resource": "*", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "ask" },
    { "action": "external_directory", "resource": "*", "effect": "ask" },
    { "action": "read", "resource": "*.env", "effect": "deny" },
    { "action": "read", "resource": "*.env.*", "effect": "deny" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" }
  ],
  "agents": {
    "build": {
      "permissions": [
        { "action": "execute", "resource": "*", "effect": "allow" },
        { "action": "opencode_list_mcp_resources", "resource": "*", "effect": "deny" },
        { "action": "opencode_read_mcp_resource", "resource": "*", "effect": "deny" },
        { "action": "supabase_duna_get_project_url", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_list_migrations", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_list_tables", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_list_extensions", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_get_advisors", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_search_docs", "resource": "*", "effect": "allow" },
        { "action": "supabase_duna_get_logs", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_query_logs", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_generate_typescript_types", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_execute_sql", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_apply_migration", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_list_edge_functions", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_get_edge_function", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_deploy_edge_function", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_list_storage_buckets", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_get_storage_config", "resource": "*", "effect": "ask" },
        { "action": "supabase_duna_update_storage_config", "resource": "*", "effect": "ask" }
      ]
    }
  },
  "policies": [
    { "action": "tool.use", "resource": "supabase_*:*", "effect": "deny" },
    { "action": "tool.use", "resource": "supabase_duna_search_docs:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_get_project_url:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_list_migrations:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_list_tables:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_list_extensions:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_get_advisors:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_get_logs:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_query_logs:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_generate_typescript_types:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_execute_sql:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_apply_migration:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_list_edge_functions:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_get_edge_function:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_deploy_edge_function:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_list_storage_buckets:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_get_storage_config:*", "effect": "allow" },
    { "action": "tool.use", "resource": "supabase_duna_update_storage_config:*", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.env*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*/.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.agents/*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout -- *", "effect": "deny" }
  ]
}
